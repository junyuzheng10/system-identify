    name="torso">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1e-10" />
      <inertia
        ixx="1e-10"
        ixy="0"
        ixz="0"
        iyy="1e-10"
        iyz="0"
        izz="1e-10" />
    </inertial>
  </link>
  <joint
    name="torso_base_joint"
    type="fixed">
    <origin
      xyz="-0.0046 0.0 0"
      rpy="0.0 0 0" />
    <parent
      link="world" />
    <child
      link="torso" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="0"
      upper="0"
      effort="0"
      velocity="0" />
  </joint>
  <joint name="leftbase_fixed" type="fixed">
    <parent link="torso"/>
    <child link="AR5-5_07L-W4C4A2_base"/>
